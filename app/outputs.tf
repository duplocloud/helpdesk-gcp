locals {
  gateway_ip = module.helpdesk.gateway_ip

  # GCP gives an IP, so these are A records. Empty in managed mode (Terraform created them).
  dns_records = local.managed_dns || local.gateway_ip == "" ? [] : [
    { name = var.deployment.host, type = "A", value = local.gateway_ip },
    { name = var.deployment.xterm_host, type = "A", value = local.gateway_ip },
  ]
}

output "gateway_ip" {
  description = "IP address of the external Gateway; both hostnames point here"
  value       = local.gateway_ip
}

output "helpdesk_url" {
  description = "Helpdesk URL"
  value       = "https://${var.deployment.host}"
}

output "dns_records" {
  description = "A records to create at the DNS provider (empty when DNS is managed in Cloud DNS)"
  value       = local.dns_records
}

output "secrets" {
  description = "The secrets passed in (read back by takeover)"
  value       = var.secrets
  sensitive   = true
}

output "generated" {
  description = "Secrets generated by this root (read back by takeover)"
  value = {
    jwt_shared_secret     = random_password.jwt_shared_secret.result
    mongodb_root_password = random_password.mongodb_root_password.result
  }
  sensitive = true
}

output "storage_class_name" {
  description = "StorageClass of Helpdesk's shared volumes (the in-cluster NFS server's class in incluster mode)"
  value       = module.helpdesk.storage_class_name
}

output "release" {
  description = "Helm release of Helpdesk: name, namespace and chart version"
  value       = { name = module.helpdesk.release_name, namespace = module.helpdesk.namespace, chart_version = module.helpdesk.chart_version }
}
